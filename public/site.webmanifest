{
  "id": "/smoothstep",
  "name": "smoothstep.io",
  "short_name": "smoothstep",
  "description": "Make animations with WebGL shaders and a little JavaScript, right in your browser.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "theme_color": "#282a36",
  "background_color": "#282a36",
  "icons": [
    {"src": "android-chrome-192x192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "android-chrome-512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "maskable-512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "file_handlers": [
    {"action": "./", "accept": {"application/json": [".smoothstep.json", ".json"]}}
  ]
}
